# Optional cloud LLM. Without it, JARVIS uses deterministic local routing.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Google OAuth (leave blank until the Google Cloud project is configured).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/integrations/google/callback
JARVIS_DB_PATH=data/jarvis.db
JARVIS_TIMEZONE=Asia/Kolkata
BRIDGE_URL=http://localhost:3000

# Live job provider. Keep actual values only in .env, never in source control.
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
ADZUNA_COUNTRY=in

# Optional protection for a deployed API. Keep blank for local development.
JARVIS_API_KEY=

# Production hostname, used by Caddy when deploying with docker-compose.production.yml.
JARVIS_DOMAIN=

# Personal production access gate. Generate the hash with:
# docker run --rm caddy:2-alpine caddy hash-password --plaintext "YOUR-STRONG-PASSWORD"
JARVIS_ADMIN_USER=syed
JARVIS_ADMIN_PASSWORD_HASH=
